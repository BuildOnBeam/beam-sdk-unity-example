.responses-input {
    color: rgb(241, 241, 241);
}

TextField > TextInput {
    background-color: rgb(34, 34, 34);
    border-radius: 10px;
    border-color: rgb(21, 21, 21);
    color: rgb(241, 241, 241);
    caret-color: rgb(241, 241, 241);
}

Label {
    color: rgb(241, 241, 241);
}

.unity-button {
    border-radius: 15px;
    margin: 5px;
    height: 30px;
    max-height: 30px;
    min-height: 30px;
    width: 200px;
    color: rgb(241, 241, 241);
    max-width: 200px;
    min-width: 200px;
    padding: 5px;
    border-color: rgb(19, 19, 19);
    background-color: rgb(26, 26, 26);
    -unity-text-align: middle-center;
}

.beam-input-small {
    width: 300px;
    margin: 10px;
}

.container {
    margin-top: 50px;
    margin-bottom: 50px;
    margin-right: 10px;
    margin-left: 10px;
}

.input-panel {
    width: auto;
    align-items: auto;
    align-self: center;
    position: relative;
    right: 5px;
    top: 5px;
}

.responses-input {
    height: 300px;
    max-height: 300px;
    width: 90%;
    align-self: center;
    min-height: 30px;
}

.button-panel {
    flex-grow: 1;
    width: auto;
    height: auto;
    position: relative;
    align-self: center;
    align-items: flex-start;
    justify-content: flex-start;
}

.beam-logo {
    flex-grow: 1;
    background-image: url("project://database/Assets/Images/beam-logo.png?fileID=21300000&guid=f5b435436de9247a4ad30febb228564d&type=3#beam-logo");
    width: 100%;
    height: 30px;
    align-self: flex-start;
    -unity-background-scale-mode: scale-to-fit;
    max-height: 30px;
}